                <span>${escapeHtml(item.nickname)}</span>
              </span>
            </td>
            <td class="py-3 px-4">${maskedTarget}</td>
            <td class="py-3 px-4 text-center">${statusBadge}</td>
          </tr>`;
      }).join("");
    }

    function escapeHtml(str) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    // 12. QR코드 생성
    function getStudentJoinUrl() {
      if (state.appsScriptUrl && /^https:\/\/script\.google\.com\//i.test(state.appsScriptUrl)) {
        const sep = state.appsScriptUrl.includes("?") ? "&" : "?";
        return `${state.appsScriptUrl}${sep}room=${encodeURIComponent(state.room)}&role=student`;
      }

      const base = window.location.href.split("#")[0].split("?")[0];
      const payload = encodePayloadBase64({
        room: state.room,
        round: state.round,
        assignments: state.assignments.map((a) => ({
          angel: a.angel,
          target: a.target,
          nickname: a.nickname,
          emoji: a.emoji,
          drawn: a.drawn
        }))
      });

      return `${base}?room=${encodeURIComponent(state.room)}&role=student${payload ? `#d=${payload}` : ""}`;
    }

    function isSandboxOrLocalUrl() {
      const href = window.location.href;
      return (
        href.startsWith("about:") ||
        href.startsWith("blob:") ||
        href.startsWith("file:") ||
        href.includes("googleusercontent.com")
      );
    }

    function renderQRCode() {
      const box = document.getElementById("qrcode-box");
      const preview = document.getElementById("join-url-preview");
      const warning = document.getElementById("sandbox-warning-banner");
      if (!box) return;

      const joinUrl = getStudentJoinUrl();
      if (preview) preview.textContent = joinUrl;

      if (warning) {
        if (isSandboxOrLocalUrl() && !state.appsScriptUrl) {
          warning.classList.remove("hidden");
        } else {
          warning.classList.add("hidden");
        }
      }

      box.innerHTML = "";
      try {
        if (typeof QRCode !== "undefined" && joinUrl.length <= 900) {
          new QRCode(box, {
            text: joinUrl,
            width: 184,
            height: 184,
            colorDark: "#1e293b",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.L
          });
          return;
        }
      } catch (e) {}

      const img = document.createElement("img");
      img.src = `https://api.qrserver.com/v1/create-qr-code/?size=190x190&ecc=L&data=${encodeURIComponent(joinUrl)}`;
      img.alt = "수호천사 접속 QR코드";
      img.className = "w-[184px] h-[184px] rounded-xl";
      img.onerror = () => {
        box.innerHTML = `<div class="text-xs text-slate-500 p-4">QR 이미지를 불러오지 못했어요.<br/>아래 <b>[접속 링크 복사]</b>를 이용해 주세요!</div>`;
      };
      box.appendChild(img);
    }

    window.copyJoinUrl = function() {
      copyTextSafely(getStudentJoinUrl(), "아이들 접속 링크가 복사되었어요!");
    };

    // 13. 아이들 화면: 빠른 이름 칩 & 777 스타일 1칸 비밀 카드 슬롯 & 1초 살짝 보기
    const SLOT_CARD_COLORS = [
      "linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%)",
      "linear-gradient(135deg, #FCE7F3 0%, #FBCFE8 100%)",
      "linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%)",
      "linear-gradient(135deg, #DCFCE7 0%, #BBF7D0 100%)",
      "linear-gradient(135deg, #F3E8FF 0%, #DDD6FE 100%)",
      "linear-gradient(135deg, #FFEDD5 0%, #FED7AA 100%)"
    ];

    function buildSlotCardHTML(emoji, label, bgStyle, isWinner = false) {
      const borderClass = isWinner
        ? "border-4 border-amber-400 shadow-md"
        : "border-2 border-amber-200/80 shadow-2xs";
      return `
        <div class="h-[148px] mb-[12px] rounded-2xl ${borderClass} flex flex-col items-center justify-center px-3 select-none" style="background: ${bgStyle};">
          <div class="text-5xl sm:text-6xl leading-none drop-shadow-2xs">${emoji}</div>
          <div class="font-cute text-2xl sm:text-3xl text-slate-800 mt-2 tracking-wide truncate max-w-full">${escapeHtml(label)}</div>
        </div>`;
    }

    function renderSlotIdle() {
      const strip = document.getElementById("slot-reel-strip");
      const guide = document.getElementById("slot-center-guide");
      if (!strip) return;

      strip.classList.remove("slot-reel-blur");
      strip.style.transform = "translate3d(0, 20px, 0)";
      if (guide) {
        guide.className = "pointer-events-none absolute inset-x-2 top-1/2 -translate-y-1/2 h-[148px] rounded-2xl border-2 border-dashed border-pink-300/90 z-10 flex items-center justify-between px-1.5 transition-all duration-200";
      }

      strip.innerHTML =
        buildSlotCardHTML("👼", "비밀 수호천사 카드", "linear-gradient(135deg, #FEF3C7 0%, #FCE7F3 100%)") +
        buildSlotCardHTML("✨", "띠리릭~ 돌려보아요!", "linear-gradient(135deg, #E0F2FE 0%, #F3E8FF 100%)");
    }

    function renderStudentQuickChips() {
      const container = document.getElementById("student-quick-chips");
      if (!container) return;

      if (!state.assignments.length) {
        container.innerHTML = `<span class="text-xs text-slate-400 py-2">선생님이 아직 우리 반 명단을 준비하고 있어요 👼</span>`;
        return;
      }

      const typed = (document.getElementById("student-name-input")?.value || "").trim();

      container.innerHTML = state.assignments.map((item) => {
        const isSelected = typed && item.angel === typed;
        let chipStyle = item.drawn
          ? "bg-emerald-50 text-emerald-700 border-emerald-300"
          : "bg-white hover:bg-amber-50 text-slate-700 border-slate-200";
        if (isSelected) {
          chipStyle += " ring-3 ring-pink-300 border-pink-400";
        }
        return `
          <button type="button" data-angel="${escapeHtml(item.angel)}" onclick="selectStudentChip(this.dataset.angel)" class="btn-jelly px-3.5 py-2 rounded-full border-2 text-sm sm:text-base font-bold shadow-2xs ${chipStyle}">
            ${escapeHtml(item.angel)}${item.drawn ? " ✓" : ""}
