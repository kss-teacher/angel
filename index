    window.selectStudentChip = function(name) {
      const input = document.getElementById("student-name-input");
      if (input) input.value = name;
      const liveStatus = document.getElementById("wheel-live-status");
      if (liveStatus) {
        liveStatus.textContent = `🌟 ${name} 천사님 준비 완료! 카드 슬롯 버튼을 꾹 눌러요 뀽!`;
      }
      renderStudentQuickChips();
      renderSlotIdle();
      playTickSound();
    };

    // 777 스타일 1칸 카드 슬롯: 띠리릭~ 돌아가다가 블라인드 후 빠밤! 정중앙 안착
    window.spinWheel = function() {
      if (state.isSpinning) return;

      const input = document.getElementById("student-name-input");
      const typedName = (input ? input.value : "").trim();

      if (!state.assignments.length) {
        showToast("선생님이 아직 마니또 배정을 시작하지 않았어요!", "👼");
        return;
      }

      const foundIndex = state.assignments.findIndex(
        (a) => a.angel.replace(/\s+/g, "") === typedName.replace(/\s+/g, "")
      );

      if (foundIndex === -1) {
        showToast("내 이름을 아래 버튼에서 누르거나 정확히 적어주세요!", "🙋");
        return;
      }

      const chosen = state.assignments[foundIndex];
      state.isSpinning = true;

      const spinBtn = document.getElementById("spin-wheel-btn");
      const strip = document.getElementById("slot-reel-strip");
      const guide = document.getElementById("slot-center-guide");
      const liveStatus = document.getElementById("wheel-live-status");
      if (spinBtn) spinBtn.disabled = true;

      ensureAudioCtx();

      // 매번 무작위 순서의 카드 스트립을 구성하여 위치가 특정되지 않도록 블라인드 처리
      const decoyPool = shuffleArray(
        state.assignments.length >= 4 ? state.assignments : CUTE_NICKNAMES.slice(0, 12)
      );
      const stopIdx = 28;
      const cardsMarkup = [];

      // 0번 카드: 출발 카드
      cardsMarkup.push(
        buildSlotCardHTML("👼", "비밀 카드 출발!", "linear-gradient(135deg, #FEF3C7 0%, #FCE7F3 100%)")
      );

      for (let i = 1; i <= stopIdx + 2; i++) {
        if (i === stopIdx) {
          // 최종 당첨 카드 (원래 결과 카드와 자연스럽게 이어지도록 표시)
          cardsMarkup.push(
            buildSlotCardHTML(
              chosen.emoji,
              chosen.nickname,
              "linear-gradient(135deg, #FEF08A 0%, #FBCFE8 55%, #DDD6FE 100%)",
              true
            )
          );
        } else if (i % 4 === 0 && i < stopIdx - 4) {
          // 중간 블라인드 미스터리 카드
          cardsMarkup.push(
            buildSlotCardHTML("❓", "띠리릭~ 비밀 카드!", "linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%)")
          );
        } else {
          const item = decoyPool[i % decoyPool.length];
          cardsMarkup.push(
            buildSlotCardHTML(item.emoji, item.nickname, SLOT_CARD_COLORS[i % SLOT_CARD_COLORS.length])
          );
        }
      }

      if (strip) {
        strip.innerHTML = cardsMarkup.join("");
        strip.style.transform = "translate3d(0, 20px, 0)";
      }
      if (guide) {
        guide.className = "pointer-events-none absolute inset-x-2 top-1/2 -translate-y-1/2 h-[148px] rounded-2xl border-2 border-dashed border-pink-400 z-10 flex items-center justify-between px-1.5 transition-all duration-200";
      }

      const CARD_PITCH = 160; // 148px 카드 + 12px 간격
      const targetOffset = stopIdx * CARD_PITCH;
      const phase1End = (stopIdx - 3) * CARD_PITCH;
      const duration = 3600;
      const startTime = performance.now();
      let lastCardStep = 0;
      let playedLandSound = false;

      function animateSlot(now) {
        const elapsed = now - startTime;
        const p = Math.min(elapsed / duration, 1);
        let currentOffset = 0;

        if (p < 0.65) {
          // 1단계: 띠리릭~ 띠리릭~ 블라인드 고속 회전
          const u = p / 0.65;
          const smooth = u * u * (3 - 2 * u);
          currentOffset = phase1End * smooth;
          if (strip) strip.classList.add("slot-reel-blur");
          if (liveStatus) liveStatus.textContent = "🎰 띠리릭~ 띠리릭~ 비밀 카드가 돌아가요!";
        } else if (p < 0.88) {
          // 2단계: 감속 구간 (한 칸씩 두근두근)
          const v = (p - 0.65) / 0.23;
          const slowEase = 1 - Math.pow(1 - v, 2);
          currentOffset = phase1End + (2.6 * CARD_PITCH) * slowEase;
          if (strip) strip.classList.remove("slot-reel-blur");
          if (liveStatus) liveStatus.textContent = "💓 두근두근... 과연 누구의 카드가 멈출까?!";
        } else {
          // 3단계: 살짝 지나쳤다가 스프링처럼 찰칵! 빠밤!!
          const w = (p - 0.88) / 0.12;
          const fromOffset = targetOffset - 0.4 * CARD_PITCH;
          const spring = 1 - Math.pow(1 - w, 2);
          const overshoot = Math.sin(w * Math.PI) * 20;
          currentOffset = fromOffset + (targetOffset - fromOffset) * spring + overshoot;
          if (strip) strip.classList.remove("slot-reel-blur");
          if (liveStatus) liveStatus.textContent = "🎉 빠밤!! 수호천사 카드가 멈췄어요!";

          if (!playedLandSound && w > 0.55) {
            playedLandSound = true;
            playSlotLandSound();
          }
        }

        if (strip) {
          strip.style.transform = `translate3d(0, ${20 - currentOffset}px, 0)`;
        }

        const currentStep = Math.floor(currentOffset / CARD_PITCH);
        if (currentStep > lastCardStep) {
          lastCardStep = currentStep;
          playTickSound();
        }

        if (p < 1) {
          requestAnimationFrame(animateSlot);
        } else {
          if (strip) {
            strip.classList.remove("slot-reel-blur");
            strip.style.transform = `translate3d(0, ${20 - targetOffset}px, 0)`;
          }
          if (guide) {
            guide.className = "pointer-events-none absolute inset-x-2 top-1/2 -translate-y-1/2 h-[148px] rounded-2xl border-4 border-amber-400 shadow-md z-10 flex items-center justify-between px-1.5 transition-all duration-200";
          }
          state.isSpinning = false;
          if (spinBtn) spinBtn.disabled = false;

          // 빠밤! 멈춘 카드를 0.75초간 보여준 뒤 결과 화면으로 자연스럽게 전환
          setTimeout(() => completeStudentSpin(chosen), 750);
        }
      }

      requestAnimationFrame(animateSlot);
    };

    async function completeStudentSpin(assignment) {
      assignment.drawn = true;
      state.currentStudentAssignment = assignment;
      state.lastLocalWriteAt = Date.now();
      saveToLocalStorage();
      renderHostTable();
      renderStudentQuickChips();
      playFanfareSound();
      showStudentResultCard(assignment);

      if (state.appsScriptUrl) {
        try {
          await fetch(state.appsScriptUrl, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify({
              action: "markDrawn",
              room: state.room,
              angel: assignment.angel
            })
          });
        } catch (e) {}
      }
    }

    function showStudentResultCard(assignment) {
      document.getElementById("student-spin-stage").classList.add("hidden");
      const resStage = document.getElementById("student-result-stage");
      resStage.classList.remove("hidden");

      document.getElementById("res-angel-name").textContent = assignment.angel;
      document.getElementById("res-target-emoji").textContent = assignment.emoji;
      document.getElementById("res-target-nickname").textContent = assignment.nickname;
      document.getElementById("res-target-realname").textContent = assignment.target;

      const nickLayer = document.getElementById("nickname-display-layer");
      const secretOverlay = document.getElementById("secret-name-overlay");
      nickLayer.classList.remove("nickname-blur");
      nickLayer.classList.add("nickname-clear");
      secretOverlay.classList.add("hidden");
    }

    // 별명 터치 시 별명이 흐려지며 친구 진짜 이름이 1초 동안 아주 작게 보였다가 다시 별명이 보이는 기능
    window.peekSecretName = function() {
      const nickLayer = document.getElementById("nickname-display-layer");
      const secretOverlay = document.getElementById("secret-name-overlay");
      if (!nickLayer || !secretOverlay) return;

      if (state.peekTimer) {
        clearTimeout(state.peekTimer);
        state.peekTimer = null;
      }

      playPeekSound();
      nickLayer.classList.remove("nickname-clear");
      nickLayer.classList.add("nickname-blur");
      secretOverlay.classList.remove("hidden");

      state.peekTimer = setTimeout(() => {
        nickLayer.classList.remove("nickname-blur");
        nickLayer.classList.add("nickname-clear");
        secretOverlay.classList.add("hidden");
        state.peekTimer = null;
      }, 1000);
    };

    window.resetStudentView = function() {
      if (state.peekTimer) {
        clearTimeout(state.peekTimer);
        state.peekTimer = null;
      }
      document.getElementById("student-result-stage").classList.add("hidden");
      document.getElementById("student-spin-stage").classList.remove("hidden");
      document.getElementById("student-name-input").value = "";
      const liveStatus = document.getElementById("wheel-live-status");
      if (liveStatus) liveStatus.textContent = "✨ 내 이름을 누르고 띠리릭~ 카드 슬롯을 돌려보세요!";
      renderStudentQuickChips();
      renderSlotIdle();
    };

    // 14. 활동기록판 PDF & 별자리 수행판 (10/15/20개 + 아이들마다 다른 별자리 랜덤 배정)
    window.setConstellationStarCount = function(count) {
      state.printStarCount = count;
      [10, 15, 20].forEach((num) => {
        const btn = document.getElementById("star-count-" + num);
        if (!btn) return;
        if (num === count) {
          btn.className = "btn-jelly py-2 rounded-xl font-bold text-xs sm:text-sm bg-purple-600 text-white shadow-xs";
        } else {
          btn.className = "btn-jelly py-2 rounded-xl font-bold text-xs sm:text-sm bg-white text-purple-800 border border-purple-200";
        }
      });
      renderPrintCards();
    };

    window.setConstellationMode = function(mode) {
      state.constellationMode = mode;
      renderPrintCards();
    };

    window.reshuffleStudentConstellations = function() {
      if (!state.assignments.length) {
        showToast("먼저 선생님 화면에서 명단을 배정해 주세요!", "⚠️");
        return;
      }
      state.constellationMode = "random";
      document.getElementById("constellation-mode-select").value = "random";
      const shuffled = shuffleArray(CONSTELLATION_KEYS);
      state.assignments.forEach((a, i) => {
        a.constellationKey = shuffled[i % shuffled.length];
