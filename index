<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>우리 반 수호천사 마니또 게임 👼</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- 1학년 아이들을 위한 동글동글 귀여운 한글 폰트 (Jua + Noto Sans KR) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jua&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <!-- QR코드 생성 라이브러리 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <!-- 구글 사이트 보안 액자 안에서도 1클릭으로 진짜 PDF 파일을 생성하는 라이브러리 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <style>
    :root {
      --font-cute: 'Jua', 'Noto Sans KR', sans-serif;
      --font-body: 'Noto Sans KR', sans-serif;
    }

    body {
      font-family: var(--font-body);
      background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 35%, #fce7f3 70%, #e0f2fe 100%);
      min-height: 100vh;
      color: #334155;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    .font-cute {
      font-family: var(--font-cute);
      letter-spacing: 0.02em;
    }

    /* 둥실둥실 애니메이션 */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-6px) rotate(2deg); }
    }
    .animate-float {
      animation: floatSlow 3.2s ease-in-out infinite;
    }

    @keyframes popIn {
      0% { transform: scale(0.85); opacity: 0; }
      70% { transform: scale(1.04); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* 1칸 카드 슬롯 전구 반짝임 및 블라인드 블러 효과 */
    @keyframes bulbBlink {
      0%, 100% { opacity: 0.45; transform: scale(0.92); }
      50% { opacity: 1; transform: scale(1.15); }
    }
    .slot-bulb {
      animation: bulbBlink 0.9s ease-in-out infinite;
    }
    .slot-bulb:nth-child(even) {
      animation-delay: 0.45s;
    }
    .slot-reel-blur {
      filter: blur(2.2px);
    }

    /* 말랑말랑 3D 버튼 효과 */
    .btn-jelly {
      transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.15s ease;
    }
    .btn-jelly:active:not(:disabled) {
      transform: translateY(3px) scale(0.98);
    }

    /* 1초 살짝 보기 전환 효과 */
    .nickname-blur {
      filter: blur(8px);
      opacity: 0.18;
      transform: scale(0.94);
    }
    .nickname-clear {
      filter: blur(0px);
      opacity: 1;
      transform: scale(1);
    }

    /* 마스코트 뀽이 반짝임 */
    @keyframes wandSparkle {
      0%, 100% { transform: rotate(-4deg) scale(1); }
      50% { transform: rotate(6deg) scale(1.06); }
    }
    .kkyung-mascot-hover:hover {
      animation: wandSparkle 0.8s ease-in-out infinite;
    }

    /* 인쇄 / PDF 변환 전용 스타일 */
    @media print {
      @page {
        size: A4 portrait;
        margin: 10mm;
      }
      body {
        background: #ffffff !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only-area {
        display: block !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .activity-sheet-card {
        break-inside: avoid;
        page-break-inside: avoid;
        box-shadow: none !important;
        border: 2px dashed #94a3b8 !important;
        margin-bottom: 8mm !important;
      }
      .activity-sheet-card.single-per-page {
        break-after: page;
        page-break-after: always;
        min-height: 265mm;
      }
    }
  </style>
</head>
<body class="pb-16">

  <!-- 상단 토스트 알림 배너 (alert 대체) -->
  <div id="toast-container" class="no-print fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[92%] max-w-md pointer-events-none transition-all duration-300 opacity-0 -translate-y-4">
    <div id="toast-box" class="bg-slate-800/95 text-white px-5 py-3.5 rounded-2xl shadow-xl border-2 border-amber-300 flex items-center gap-3 text-sm sm:text-base font-medium">
      <span id="toast-icon" class="text-xl">👼</span>
      <span id="toast-msg" class="leading-snug">알림 메시지</span>
    </div>
  </div>

  <!-- 커스텀 확인 모달 (confirm 대체) -->
  <div id="confirm-modal" class="no-print fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border-4 border-amber-200 animate-pop text-center">
      <div id="confirm-emoji" class="text-5xl mb-3">👼</div>
      <h3 id="confirm-title" class="font-cute text-2xl text-slate-800 mb-2">확인해 주세요!</h3>
      <p id="confirm-desc" class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">정말 진행할까요?</p>
      <div class="grid grid-cols-2 gap-3">
        <button type="button" onclick="closeConfirmModal(false)" class="btn-jelly py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-base">
          취소할래요
        </button>
        <button type="button" id="confirm-ok-btn" onclick="closeConfirmModal(true)" class="btn-jelly py-3 px-4 rounded-2xl bg-gradient-to-r from-amber-400 to-orange-400 text-white font-bold text-base shadow-md">
          네, 좋아요! ✨
        </button>
      </div>
    </div>
  </div>

  <!-- 상단 헤더 & 내비게이션 -->
  <header class="no-print max-w-5xl mx-auto pt-5 px-4">
    <div class="bg-white/90 backdrop-blur-md rounded-3xl p-4 sm:p-5 shadow-lg border-2 border-amber-200 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-center md:text-left">
        <div id="header-kkyung-mascot" onclick="pokeKkyungMascot()" title="뀽이를 눌러보세요!" class="cursor-pointer w-16 h-16 sm:w-18 sm:h-18 rounded-2xl bg-gradient-to-br from-amber-100 via-pink-100 to-sky-100 border-2 border-amber-200 flex items-center justify-center shadow-inner animate-float kkyung-mascot-hover shrink-0 overflow-hidden">
          👼
        </div>
        <div>
          <div class="flex items-center justify-center md:justify-start gap-2 flex-wrap">
            <h1 class="font-cute text-2xl sm:text-3xl text-slate-800">우리 반 수호천사 마니또</h1>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-pink-100 text-pink-700 border border-pink-200">
              마스코트: 수호천사 뀽 👼
            </span>
            <span id="room-badge" class="text-xs font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-300">
              방 코드: CLASS1
            </span>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 mt-0.5">뀽이랑 같이 몰래 도와주고 반짝반짝 별자리를 완성해요 뀽! ✨</p>
        </div>
      </div>

      <!-- 우측 컨트롤 버튼들 -->
      <div class="flex items-center gap-2 flex-wrap justify-center">
        <button type="button" id="sound-toggle-btn" onclick="toggleSound()" class="btn-jelly px-3 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-xs sm:text-sm font-bold flex items-center gap-1.5" title="효과음 켜기/끄기">
          <span id="sound-icon">🔊</span>
          <span id="sound-label" class="hidden sm:inline">소리 켜짐</span>
        </button>

        <button type="button" id="sheets-modal-btn" onclick="openSheetsModal()" class="btn-jelly px-3.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border-2 border-emerald-200 text-xs sm:text-sm font-bold flex items-center gap-1.5">
          <span>📊</span>
          <span>구글 시트 연동</span>
          <span id="sheets-status-dot" class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
        </button>
      </div>
    </div>

    <!-- 화면 전환 탭 (학생 QR 접속 시 자동으로 숨겨짐) -->
    <nav id="main-nav-tabs" class="mt-4 grid grid-cols-3 gap-2 sm:gap-3 bg-white/80 p-2 rounded-2xl shadow-sm border border-amber-100">
      <button type="button" id="tab-btn-host" onclick="switchTab('host')" class="btn-jelly py-2.5 sm:py-3 px-2 rounded-xl font-cute text-base sm:text-lg flex items-center justify-center gap-1.5 transition-all bg-gradient-to-r from-amber-400 to-orange-400 text-white shadow-md">
        <span>👩‍🏫</span>
        <span>선생님 화면</span>
      </button>
      <button type="button" id="tab-btn-student" onclick="switchTab('student')" class="btn-jelly py-2.5 sm:py-3 px-2 rounded-xl font-cute text-base sm:text-lg flex items-center justify-center gap-1.5 transition-all text-slate-600 hover:bg-amber-50">
        <span>🎡</span>
        <span>아이들 돌림판</span>
      </button>
      <button type="button" id="tab-btn-print" onclick="switchTab('print')" class="btn-jelly py-2.5 sm:py-3 px-2 rounded-xl font-cute text-base sm:text-lg flex items-center justify-center gap-1.5 transition-all text-slate-600 hover:bg-amber-50">
        <span>🖨️</span>
        <span>활동기록판 PDF</span>
      </button>
    </nav>
  </header>

  <!-- 메인 콘텐츠 컨테이너 -->
  <main class="max-w-5xl mx-auto px-4 mt-5">

    <!-- =========================================================
         1. 선생님 화면 (호스트 & QR코드 & 난수 배정 현황)
    ========================================================== -->
    <section id="view-host" class="space-y-5">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

        <!-- 왼쪽: 명단 입력 및 난수 배정 컨트롤 (7컬럼) -->
        <div class="lg:col-span-7 bg-white/95 rounded-3xl p-5 sm:p-6 shadow-md border-2 border-amber-100 space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <h2 class="font-cute text-xl sm:text-2xl text-slate-800 flex items-center gap-2">
              <span>📝</span>
              <span>1단계: 우리 반 친구들 명단 & 난수 배정</span>
            </h2>
            <span id="draw-round-badge" class="text-xs font-bold px-3 py-1 rounded-full bg-pink-100 text-pink-700 border border-pink-200">
              난수표 #1
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="sm:col-span-1">
              <label for="room-code-input" class="block text-xs font-bold text-slate-500 mb-1">학급 방 코드</label>
              <input id="room-code-input" type="text" value="CLASS1" onchange="updateRoomCode(this.value)" placeholder="예: 1학년2반" class="w-full px-3.5 py-2.5 rounded-xl border-2 border-slate-200 focus:border-amber-400 focus:outline-none font-bold text-slate-700 text-sm" />
            </div>
            <div class="sm:col-span-2 flex items-end gap-1.5 flex-wrap sm:flex-nowrap">
              <button type="button" onclick="fillSampleStudents()" class="btn-jelly flex-1 py-2.5 px-2.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 text-xs sm:text-sm font-bold whitespace-nowrap">
                🐣 예시 명단
              </button>
              <button type="button" onclick="syncFromCloudManual()" class="btn-jelly py-2.5 px-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-xs sm:text-sm font-bold whitespace-nowrap">
                🔄 시트 불러오기
              </button>
              <button type="button" onclick="requestClearAll()" class="btn-jelly py-2.5 px-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 text-xs sm:text-sm font-bold whitespace-nowrap" title="화면 명단과 구글 시트를 모두 비웁니다">
                🧹 명단 초기화
              </button>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="student-names-input" class="text-xs sm:text-sm font-bold text-slate-600">
                친구 이름을 줄바꿈 또는 쉼표(,)로 입력해 주세요 (최소 2명)
              </label>
              <span id="student-count-label" class="text-xs font-bold text-amber-600">현재 0명</span>
            </div>
            <textarea id="student-names-input" rows="4" placeholder="김민준, 이서연, 박도윤, 최지우, 정하준, 강서윤, 조시우, 윤하은" class="w-full p-3.5 rounded-2xl border-2 border-amber-200 focus:border-amber-400 focus:outline-none text-slate-700 text-sm sm:text-base leading-relaxed bg-amber-50/30"></textarea>
          </div>

          <!-- 난수 생성 및 초기화 버튼 그룹 -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
            <button type="button" onclick="generateNewAssignments(false)" class="btn-jelly sm:col-span-1 py-3 px-4 rounded-2xl bg-gradient-to-r from-amber-400 to-orange-400 hover:from-amber-500 hover:to-orange-500 text-white font-cute text-lg shadow-md flex items-center justify-center gap-1.5">
              <span>✨</span>
              <span>마니또 배정하기</span>
            </button>
            <button type="button" onclick="requestReShuffle()" class="btn-jelly py-3 px-3 rounded-2xl bg-pink-50 hover:bg-pink-100 text-pink-700 border-2 border-pink-200 font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5">
              <span>🎲</span>
              <span>난수표 초기화 (다시 뽑기)</span>
            </button>
            <button type="button" onclick="requestResetSpinsOnly()" class="btn-jelly py-3 px-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5">
              <span>🔄</span>
              <span>돌림판만 초기화</span>
            </button>
          </div>
        </div>

        <!-- 오른쪽: 학생 접속용 QR코드 카드 (5컬럼) -->
        <div class="lg:col-span-5 bg-white/95 rounded-3xl p-5 sm:p-6 shadow-md border-2 border-sky-100 flex flex-col items-center justify-between text-center">
          <div class="w-full">
            <h2 class="font-cute text-xl sm:text-2xl text-slate-800 flex items-center justify-center gap-2">
              <span>📱</span>
              <span>2단계: 아이들 접속 QR코드</span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">아이들이 태블릿/스마트폰 카메라로 찍으면 바로 돌림판이 열려요!</p>
          </div>

          <!-- 샌드박스/미리보기 환경 안내 배너 -->
          <div id="sandbox-warning-banner" class="hidden w-full mt-3 p-3 rounded-2xl bg-amber-50 border border-amber-300 text-left text-xs text-amber-900 leading-relaxed">
            <p class="font-bold flex items-center gap-1">
              <span>💡</span>
              <span>핸드폰으로 QR 접속 시 꼭 확인하세요!</span>
            </p>
            <p class="mt-1">현재 화면은 작업창 미리보기 주소라 핸드폰에서 직접 열리지 않아요. 상단 <b>[📊 구글 시트 연동]</b>에서 배포 URL을 연결하시면 <b>실제 Google 모바일 접속 QR</b>로 자동 전환됩니다!</p>
          </div>

          <!-- QR코드 렌더링 박스 -->
          <div class="my-4 p-4 bg-white rounded-3xl border-4 border-dashed border-sky-200 shadow-inner flex items-center justify-center min-h-[200px] min-w-[200px]">
            <div id="qrcode-box" class="flex items-center justify-center"></div>
          </div>

          <div class="w-full space-y-2">
            <div class="bg-slate-50 px-3 py-2 rounded-xl border border-slate-200 text-[11px] text-slate-500 truncate" id="join-url-preview">
              접속 주소 준비 중...
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" onclick="copyJoinUrl()" class="btn-jelly py-2.5 px-3 rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-bold text-xs sm:text-sm shadow-xs">
                🔗 접속 링크 복사
              </button>
              <button type="button" onclick="switchTab('student')" class="btn-jelly py-2.5 px-3 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold text-xs sm:text-sm">
                👀 학생 화면 미리보기
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 하단: 실시간 수호천사 배정 현황표 -->
      <div class="bg-white/95 rounded-3xl p-5 sm:p-6 shadow-md border-2 border-amber-100">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
          <div>
            <h3 class="font-cute text-xl sm:text-2xl text-slate-800 flex items-center gap-2">
              <span>📋</span>
              <span>수호천사 배정 현황표 (고정 난수표)</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
              교실 TV에 띄울 때는 <b>비밀 모드</b>를 켜두면 아이들이 누구를 뽑았는지 볼 수 없어요!
            </p>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <span id="progress-counter" class="text-xs sm:text-sm font-bold px-3 py-2 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200">
              뽑기 완료: 0 / 0명
            </span>
            <button type="button" id="secret-toggle-btn" onclick="toggleHostSecretMode()" class="btn-jelly px-3.5 py-2 rounded-xl bg-slate-800 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow-xs">
              <span id="secret-toggle-icon">🙈</span>
              <span id="secret-toggle-text">대상 이름 가리기 (비밀 모드 ON)</span>
            </button>
            <button type="button" onclick="requestClearAll()" class="btn-jelly px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 font-bold text-xs sm:text-sm">
              🗑️ 전체 비우기
            </button>
          </div>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-amber-50/80 text-slate-700 text-xs sm:text-sm border-b border-amber-200">
                <th class="py-3 px-4 font-bold">번호</th>
                <th class="py-3 px-4 font-bold">👼 수호천사 (뽑는 아이)</th>
                <th class="py-3 px-4 font-bold">🐾 부여된 비밀 별명</th>
                <th class="py-3 px-4 font-bold">🎯 도와줄 친구 (대상)</th>
                <th class="py-3 px-4 font-bold text-center">돌림판 상태</th>
              </tr>
            </thead>
            <tbody id="host-table-body" class="divide-y divide-slate-100 text-sm sm:text-base">
              <!-- JS로 렌더링 -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- =========================================================
         2. 아이들 화면 (1학년 맞춤 샬랄라 심쿵 돌림판 + 1초 이름 살짝 보기)
    ========================================================== -->
    <section id="view-student" class="hidden max-w-xl mx-auto">
      <div class="bg-white/95 rounded-3xl p-5 sm:p-7 shadow-xl border-4 border-amber-200 text-center relative overflow-hidden">
        <!-- 장식용 별빛 -->
        <div class="absolute top-3 left-4 text-2xl opacity-60 pointer-events-none">✨</div>
        <div class="absolute top-3 right-4 text-2xl opacity-60 pointer-events-none">🌟</div>

