    // 11. 선생님 화면 테이블 렌더링
    function renderHostTable() {
      const tbody = document.getElementById("host-table-body");
      const roundBadge = document.getElementById("draw-round-badge");
      const counter = document.getElementById("progress-counter");
      if (!tbody) return;

