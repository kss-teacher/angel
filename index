    function generateConstellationPoints(anchors, targetCount) {
      if (!anchors || anchors.length < 2) return [];
      if (anchors.length === targetCount) return anchors.map((p) => ({ ...p }));

      const segLengths = [];
      let totalLen = 0;
      for (let i = 0; i < anchors.length - 1; i++) {
        const dx = anchors[i + 1].x - anchors[i].x;
        const dy = anchors[i + 1].y - anchors[i].y;
        const len = Math.hypot(dx, dy);
        segLengths.push(len);
        totalLen += len;
      }

      const points = [];
      for (let k = 0; k < targetCount; k++) {
        const targetDist = (k / (targetCount - 1)) * totalLen;
        let acc = 0;
        let placed = false;
        for (let i = 0; i < segLengths.length; i++) {
          const seg = segLengths[i];
          if (acc + seg >= targetDist || i === segLengths.length - 1) {
            const ratio = seg > 0 ? Math.min(Math.max((targetDist - acc) / seg, 0), 1) : 0;
            points.push({
              x: Math.round(anchors[i].x + (anchors[i + 1].x - anchors[i].x) * ratio),
              y: Math.round(anchors[i].y + (anchors[i + 1].y - anchors[i].y) * ratio)
            });
            placed = true;
            break;
          }
          acc += seg;
        }
        if (!placed) points.push({ ...anchors[anchors.length - 1] });
      }
      return points;
    }

    function createStarPolygonPoints(cx, cy, outerR, innerR) {
      const pts = [];
      for (let i = 0; i < 10; i++) {
        const r = i % 2 === 0 ? outerR : innerR;
        const angle = (Math.PI / 5) * i - Math.PI / 2;
        pts.push(`${(cx + r * Math.cos(angle)).toFixed(1)},${(cy + r * Math.sin(angle)).toFixed(1)}`);
      }
      return pts.join(" ");
    }

    function buildConstellationSVG(constellationKey, starCount) {
      const data = CONSTELLATIONS[constellationKey] || CONSTELLATIONS.crown;
      const points = generateConstellationPoints(data.anchors, starCount);
      const polylineStr = points.map((p) => `${p.x},${p.y}`).join(" ");
      const starRadius = starCount === 20 ? 11.5 : starCount === 15 ? 13 : 14.5;

      const starsMarkup = points.map((pt, idx) => {
        const num = idx + 1;
        const isStart = idx === 0;
        const isEnd = idx === points.length - 1;
        const fill = isStart ? "#FEF3C7" : isEnd ? "#FCE7F3" : "#FFFFFF";
        const stroke = isStart ? "#D97706" : isEnd ? "#DB2777" : "#6366F1";

        return `
          <g>
            <polygon points="${createStarPolygonPoints(pt.x, pt.y, starRadius, starRadius * 0.46)}"
                     fill="${fill}" stroke="${stroke}" stroke-width="1.8" />
            <text x="${pt.x}" y="${pt.y + 3.2}" text-anchor="middle" font-size="8.5" font-weight="800" fill="#1e293b">${num}</text>
            ${isStart ? `<text x="${pt.x}" y="${pt.y + starRadius + 9}" text-anchor="middle" font-size="8" font-weight="800" fill="#FDE68A">출발</text>` : ""}
            ${isEnd ? `<text x="${pt.x}" y="${pt.y + starRadius + 9}" text-anchor="middle" font-size="8" font-weight="800" fill="#F9A8D4">완성!</text>` : ""}
          </g>`;
      }).join("");

      return `
        <svg viewBox="0 0 420 212" width="420" height="212" class="w-full h-auto max-h-[225px] bg-gradient-to-b from-indigo-950 via-slate-900 to-indigo-950 rounded-2xl border-2 border-indigo-200 p-1">
          <circle cx="24" cy="24" r="1.5" fill="#FDE68A" opacity="0.7" />
          <circle cx="392" cy="28" r="1.8" fill="#FBCFE8" opacity="0.7" />
          <circle cx="395" cy="184" r="1.4" fill="#BAE6FD" opacity="0.7" />
          <circle cx="22" cy="186" r="1.6" fill="#FDE68A" opacity="0.7" />
          <polyline points="${polylineStr}" fill="none" stroke="#A5B4FC" stroke-width="2.2" stroke-dasharray="5,4" stroke-linecap="round" stroke-linejoin="round" />
          ${starsMarkup}
        </svg>`;
    }

