          <tr>
            <td colspan="5" class="py-10 text-center text-slate-400 text-sm">
              위 입력칸에 우리 반 친구들 이름을 적고 <b>[✨ 마니또 배정하기]</b> 버튼을 눌러주세요!
            </td>
          </tr>`;
        return;
      }

      tbody.innerHTML = state.assignments.map((item, idx) => {
        const maskedTarget = state.hostSecretMode
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-slate-100 text-slate-400 text-xs font-bold">🔒 비밀 가림</span>`
          : `<span class="font-bold text-rose-600">${escapeHtml(item.target)}</span>`;

        const statusBadge = item.drawn
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">✅ 뽑기 완료</span>`
          : `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-bold">⏳ 대기 중</span>`;

        return `
