      const a = document.createElement("a");
      a.href = url;
      a.download = `수호천사_마니또_${state.room}.csv`;
      a.click();
      URL.revokeObjectURL(url);
      showToast("CSV 파일이 저장되었어요!", "💾");
    };

    // 16. 로컬 스토리지 저장/복원 및 URL 파라미터 초기화
    function getStorageKey() {
      return `manito_angel_v2_${state.room}`;
    }

    function saveToLocalStorage() {
      try {
        localStorage.setItem(
          getStorageKey(),
          JSON.stringify({
            round: state.round,
            assignments: state.assignments,
            appsScriptUrl: state.appsScriptUrl
          })
        );
      } catch (e) {}
    }

    function loadFromLocalStorage() {
      try {
        const raw = localStorage.getItem(getStorageKey());
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (parsed.round) state.round = parsed.round;
        if (Array.isArray(parsed.assignments)) state.assignments = parsed.assignments;
        if (parsed.appsScriptUrl) state.appsScriptUrl = parsed.appsScriptUrl;
      } catch (e) {}
    }

    window.updateRoomCode = function(newCode) {
      const cleaned = (newCode || "CLASS1").trim().replace(/[^a-zA-Z0-9가-힣_-]/g, "") || "CLASS1";
      state.room = cleaned;
      document.getElementById("room-code-input").value = cleaned;
      document.getElementById("room-badge").textContent = `방 코드: ${cleaned}`;
      loadFromLocalStorage();
      renderAllViews();
      if (state.appsScriptUrl) pullFromGoogleSheets(true);
    };

    function renderAllViews() {
      renderHostTable();
      renderQRCode();
      renderStudentQuickChips();
      renderSlotIdle();
      renderPrintCards();
      updateSheetsStatusDot(Boolean(state.appsScriptUrl));
    }

    // 페이지 로드 시 초기화
    window.addEventListener("DOMContentLoaded", () => {
      const params = new URLSearchParams(window.location.search);
      const urlRoom = params.get("room");
      const urlRole = params.get("role");
      const urlSheet = params.get("sheet");

      if (urlRoom) {
        state.room = urlRoom;
        document.getElementById("room-code-input").value = urlRoom;
        document.getElementById("room-badge").textContent = `방 코드: ${urlRoom}`;
      }

      loadFromLocalStorage();

      if (urlSheet) {
        state.appsScriptUrl = urlSheet;
      }

      if (window.location.hash && window.location.hash.startsWith("#d=")) {
        const decoded = decodePayloadBase64(window.location.hash.slice(3));
        if (decoded && Array.isArray(decoded.assignments) && decoded.assignments.length > 0) {
          state.room = decoded.room || state.room;
          state.round = decoded.round || state.round;
          state.assignments = decoded.assignments;
        }
      }

      const nameInput = document.getElementById("student-names-input");
      if (nameInput) {
        if (state.assignments.length > 0) {
          nameInput.value = state.assignments.map((a) => a.angel).join(", ");
        }
        nameInput.addEventListener("input", updateStudentCountLabel);
        updateStudentCountLabel();
      }

      // 공식 마스코트 '뀽' 일러스트 배치
      const headerMascot = document.getElementById("header-kkyung-mascot");
      if (headerMascot) headerMascot.innerHTML = getKkyungMascotSVG("w-full h-full");
      const resultMiniMascot = document.getElementById("result-kkyung-mini");
      if (resultMiniMascot) resultMiniMascot.innerHTML = getKkyungMascotSVG("w-7 h-7");
      const floatingMascot = document.getElementById("floating-kkyung-svg");
      if (floatingMascot) floatingMascot.innerHTML = getKkyungMascotSVG("w-full h-full");

      renderAllViews();

      if (urlRole === "student") {
        state.isStudentLockedMode = true;
        const nav = document.getElementById("main-nav-tabs");
        const sheetsBtn = document.getElementById("sheets-modal-btn");
        if (nav) nav.classList.add("hidden");
        if (sheetsBtn) sheetsBtn.classList.add("hidden");
        switchTab("student");
      } else {
        switchTab("host");
      }

      if (state.appsScriptUrl) {
        pullFromGoogleSheets(true);
        startCloudPolling();
      }
    });
  </script>
</body>
</html>
