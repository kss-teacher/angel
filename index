      renderPrintCards();

      if (typeof window.html2canvas === "undefined" || !window.jspdf || !window.jspdf.jsPDF) {
        downloadStandalonePrintHTML();
        return;
      }

      const btn = document.getElementById("pdf-download-btn");
      const btnText = document.getElementById("pdf-download-btn-text");
      const originalText = btnText ? btnText.textContent : "활동기록판 PDF 파일 저장";

      if (btn) btn.disabled = true;
      showToast("뀽이가 예쁜 별자리 활동기록판 PDF를 만들고 있어요! 잠시만 기다려 주세요 뀽~ ✨", "🪄");

      const container = document.getElementById("print-cards-container");
      const cardEls = Array.from(container.querySelectorAll(".activity-sheet-card"));
      const perPage = state.printLayout === "1perPage" ? 1 : 2;
      const totalPages = Math.ceil(cardEls.length / perPage);

      const staging = document.createElement("div");
      staging.style.position = "fixed";
      staging.style.left = "-10000px";
      staging.style.top = "0";
      staging.style.width = "794px";
      staging.style.background = "#ffffff";
      staging.style.zIndex = "-1";
      document.body.appendChild(staging);

      try {
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ orientation: "portrait", unit: "mm", format: "a4" });

        for (let pageIdx = 0; pageIdx < totalPages; pageIdx++) {
          if (btnText) {
            btnText.textContent = `PDF 만드는 중... (${pageIdx + 1}/${totalPages}장)`;
          }

          const pageSheet = document.createElement("div");
          pageSheet.style.width = "794px";
          pageSheet.style.minHeight = "1122px";
          pageSheet.style.padding = "28px";
          pageSheet.style.background = "#ffffff";
          pageSheet.style.boxSizing = "border-box";
          pageSheet.style.display = "flex";
          pageSheet.style.flexDirection = "column";
          pageSheet.style.justifyContent = perPage === 1 ? "center" : "space-between";
          pageSheet.style.gap = "22px";

          const slice = cardEls.slice(pageIdx * perPage, (pageIdx + 1) * perPage);
          slice.forEach((origCard, idxInPage) => {
            const clone = origCard.cloneNode(true);
            clone.style.boxShadow = "none";
            clone.style.border = "2px dashed #94a3b8";
            clone.style.margin = "0";
            clone.style.background = "#ffffff";
            if (perPage === 1) {
              clone.style.padding = "32px";
            }
            pageSheet.appendChild(clone);

            if (perPage === 2 && idxInPage === 0 && slice.length === 2) {
              const cutLine = document.createElement("div");
              cutLine.style.borderTop = "1.5px dashed #cbd5e1";
              cutLine.style.textAlign = "center";
              cutLine.style.fontSize = "11px";
              cutLine.style.color = "#94a3b8";
              cutLine.style.paddingTop = "4px";
              cutLine.textContent = "✂️ ---------------------------------- 자르는 선 ---------------------------------- ✂️";
              pageSheet.appendChild(cutLine);
            }
          });

          staging.innerHTML = "";
          staging.appendChild(pageSheet);

          await new Promise((r) => setTimeout(r, 50));

          const canvas = await window.html2canvas(pageSheet, {
            scale: 2,
            backgroundColor: "#ffffff",
            useCORS: true,
            logging: false
          });

          const imgData = canvas.toDataURL("image/png");
          if (pageIdx > 0) pdf.addPage();

          const pdfW = 210;
          const pdfH = Math.min((canvas.height * pdfW) / canvas.width, 297);
          pdf.addImage(imgData, "PNG", 0, 0, pdfW, pdfH);
        }

        pdf.save(`우리반_수호천사_활동기록판_${state.room}.pdf`);
        showToast("🎉 PDF 파일이 다운로드 폴더에 저장되었어요 뀽!", "📥");
      } catch (err) {
        downloadStandalonePrintHTML();
      } finally {
        if (staging && staging.parentNode) staging.parentNode.removeChild(staging);
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = originalText;
      }
    };

